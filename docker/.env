# output directory
OUTPUT_DIR="./"

# set this to 0 to disable ccache
USE_CCACHE=1

# whether to run `git pull` on mob repository
UPDATE_MOB=1

# whether to run `mob build`
DO_BUILD=1

# whether to run `mob release`
DO_RELEASE=0

# appimage configuration. all variables are semicolon separated lists
# extra qt plugins to include
EXTRA_QT_PLUGINS="waylandcompositor"
# extra qt platform plugins to include. may be dependent on qt version
EXTRA_PLATFORM_PLUGINS="libqwayland-egl.so;libqwayland-generic.so"
# libraries to exclude
LINUXDEPLOY_EXCLUDED_LIBRARIES=""
